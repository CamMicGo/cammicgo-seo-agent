# Local development: copy to .env.local, never commit credentials.
# Set APP_BASE_URL to the exact origin used in the Google OAuth redirect URI.
APP_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=
# Private MCP must remain disabled until external OAuth and durable quotas are implemented.
ENABLE_MCP_BETA=false
# Optional personal keys for the scientific tools of the local MCP (stay on this computer).
# Guide: https://seo.cammicgo.com/setup/science  — arXiv and HAL need no key.
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
NCBI_API_KEY=
